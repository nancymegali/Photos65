<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="photos.controller.PhotosController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-padding: 10;">
            <Button text="Back" onAction="#handleBack"/>
            <Label fx:id="albumNameLabel" text="Album Name"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        </HBox>
    </top>


    <left>
        <VBox spacing="10" style="-fx-padding: 10;">
            <Label text="Photos:" style="-fx-font-size: 16px;"/>
            <ListView fx:id="photoList"
                      prefWidth="220"
                      prefHeight="500"
                      onMouseClicked="#handleSelectPhoto"/>
            <HBox spacing="10">
                <Button text="Add Photo" prefWidth="100" onAction="#handleAddPhoto"/>
                <Button text="Delete" prefWidth="100" onAction="#handleDeletePhoto"/>
            </HBox>
        </VBox>
    </left>


    <center>
        <VBox alignment="CENTER" style="-fx-padding: 10;">
            <ImageView fx:id="photoView"
                       fitWidth="450"
                       fitHeight="450"
                       preserveRatio="true"
                       smooth="true"
                       style="-fx-border-color: gray; -fx-border-width: 1;"/>
        </VBox>
    </center>


    <right>
        <VBox spacing="20" style="-fx-padding: 10;">

            <VBox spacing="5">
                <Label text="Caption:"/>
                <TextField fx:id="captionField" promptText="Enter caption..."/>
                <Button text="Save Caption" onAction="#handleSaveCaption"/>
            </VBox>

            <Separator/>

            <VBox spacing="5">
                <Label text="Tags:"/>
                <ListView fx:id="tagList" prefHeight="150"/>

                <HBox spacing="10">
                    <Button text="Add Tag" onAction="#handleAddTag"/>
                    <Button text="Delete Tag" onAction="#handleDeleteTag"/>
                </HBox>
            </VBox>

            <Separator/>

            <VBox spacing="5">
                <Label text="Album Info" style="-fx-font-size: 16px;"/>

                <Label text="Photo Count:"/>
                <Label fx:id="countLabel" text="-"/>

                <Label text="Earliest Date:"/>
                <Label fx:id="startDateLabel" text="-"/>

                <Label text="Latest Date:"/>
                <Label fx:id="endDateLabel" text="-"/>
            </VBox>

            <Separator/>

            <VBox spacing="5">
                <Label text="Copy / Move Photo:"/>
                <Button text="Copy Photo" onAction="#handleCopyPhoto"/>
                <Button text="Move Photo" onAction="#handleMovePhoto"/>
            </VBox>

        </VBox>
    </right>



    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 10;">
            <Button text="Previous" onAction="#handlePrev"/>
            <Button text="Next" onAction="#handleNext"/>
        </HBox>
    </bottom>

</BorderPane>
