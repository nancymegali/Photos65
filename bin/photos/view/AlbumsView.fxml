<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="photos.controller.AlbumsController">

    <top>
        <Label text="Your Albums"
               style="-fx-font-size: 22px; -fx-padding: 15;" />
    </top>

    <left>
        <VBox spacing="10" style="-fx-padding: 20;">
            <Label text="Albums:" style="-fx-font-size: 16px;" />

            <ListView fx:id="albumList"
                      prefWidth="250"
                      prefHeight="400" />

            <HBox spacing="10">
                <Button text="Open" onAction="#handleOpenAlbum" />
                <Button text="Delete" onAction="#handleDeleteAlbum" />
            </HBox>
        </VBox>
    </left>

    <right>
        <VBox spacing="20" style="-fx-padding: 20;">

            <VBox spacing="10">
                <Label text="Create New Album" style="-fx-font-size: 16px;" />
                <TextField fx:id="newAlbumField" 
                           promptText="Album name" 
                           prefWidth="150" />
                <Button text="Create" prefWidth="120"
                        onAction="#handleCreateAlbum" />
            </VBox>

            <Separator />

            <VBox spacing="10">
                <Label text="Album Info" style="-fx-font-size: 16px;" />

                <Label text="Photo Count:" />
                <Label fx:id="countLabel" text="-" />

                <Label text="Earliest Date:" />
                <Label fx:id="startDateLabel" text="-" />

                <Label text="Latest Date:" />
                <Label fx:id="endDateLabel" text="-" />
            </VBox>

        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button text="Logout" onAction="#handleLogout" />
        </HBox>
    </bottom>

</BorderPane>
