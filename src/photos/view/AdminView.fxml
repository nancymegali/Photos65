<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="photos.controller.AdminController">

    <top>
        <Label text="Admin Panel — Manage Users"
               style="-fx-font-size: 20px; -fx-padding: 10;" />
    </top>

    <center>
        <VBox spacing="10" alignment="CENTER">
            <Label text="Existing Users:" style="-fx-font-size: 14px;" />

            <ListView fx:id="userList" prefHeight="300" prefWidth="250" />

            <HBox spacing="10" alignment="CENTER">
                <Button text="Delete User" onAction="#handleDeleteUser" />
                <Button text="Refresh" onAction="#handleRefresh" />
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 20;">
            <Label text="Create User" style="-fx-font-size: 16px;" />

            <TextField fx:id="newUserField"
                       promptText="Enter username"
                       prefWidth="150" />

            <Button text="Create" prefWidth="100"
                    onAction="#handleCreateUser" />
        </VBox>
    </right>

    <bottom>
        <HBox alignment="CENTER_RIGHT"
              style="-fx-padding: 10;">
            <Button text="Logout" onAction="#handleLogout" />
        </HBox>
    </bottom>

</BorderPane>
