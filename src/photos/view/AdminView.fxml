<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="photos.controller.AdminController"
            prefWidth="600" prefHeight="400">

    <top>
        <Label text="Admin Panel"
               style="-fx-font-size: 24px; -fx-padding: 15;"
               BorderPane.alignment="CENTER" />
    </top>

    <left>
        <VBox spacing="10" style="-fx-padding: 20;" prefWidth="250">
            <Label text="Users:" style="-fx-font-size: 16px;" />
            <ListView fx:id="userList" prefHeight="300" />
            <Button text="Delete User" onAction="#handleDeleteUser" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER" style="-fx-padding: 20;">

            <Label text="Create New User:" style="-fx-font-size: 16px;" />

            <TextField fx:id="newUserField"
                       promptText="Enter username"
                       prefWidth="200" />

            <Button text="Create User" 
                    prefWidth="140"
                    onAction="#handleCreateUser" />

        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button text="Logout" onAction="#handleLogout" />
        </HBox>
    </bottom>

</BorderPane>
