<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="photos.controller.SearchResultsController">

    <top>
        <Label text="Search Results"
               style="-fx-font-size: 20px; -fx-padding: 10;" />
    </top>

    <center>
        <ListView fx:id="resultsList" prefHeight="400"/>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding: 10;">
            <Button text="Create Album From Results" onAction="#handleCreateAlbum" />
            <Button text="Close" onAction="#handleClose"/>
        </HBox>
    </bottom>

</BorderPane>
